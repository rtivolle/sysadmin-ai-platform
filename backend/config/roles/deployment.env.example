# Multi-host deployment role and peer addresses (PR-H1).
#
# Copy this file to `deployment.env` in the same directory and edit the values.
# `deployment.env` is git-ignored (matches `*.env`), so machine-specific
# addresses never enter the repository. If `deployment.env` is absent,
# platform.sh / install.sh behave exactly like the single-host `all` role:
# every service starts, everything binds loopback.
#
#   ROLE=all        single host — everything on this machine (today's default)
#   ROLE=web        application tier: Traefik, ForwardAuth, agent platform,
#                   sandbox, harness gateway, user workspaces
#   ROLE=inference  GPU host: LiteLLM proxy + inference engine / vLLM
#   ROLE=data       state tier: Valkey, VictoriaLogs, SeaweedFS, backups
ROLE=all

# LAN address this machine's outward-facing services bind to. Ignored when
# ROLE=all (loopback is forced). Traefik on web binds every interface and is
# restricted by backend/config/firewall/web.nft instead.
LAN_BIND_IP=127.0.0.1

# --- Peer addresses (only the ones this role reaches out to) -----------------
# web       reaches inference (LiteLLM :4000) and data (Valkey/SeaweedFS/VictoriaLogs)
# inference reaches data (Valkey/VictoriaLogs) for its in-process LiteLLM auth
# data      reaches nothing (it only serves)
PEER_INFERENCE_HOST=127.0.0.1
PEER_INFERENCE_PORT=4000
PEER_DATA_HOST=127.0.0.1
PEER_DATA_VALKEY_PORT=6379
PEER_DATA_LOGS_PORT=9428
PEER_DATA_SEAWEEDFS_PORT=8333
