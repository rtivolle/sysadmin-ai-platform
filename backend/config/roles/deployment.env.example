# Multi-host deployment role and peer addresses (PR-H1; platform/inference: Phase B).
#
# Copy this file to `deployment.env` in the same directory and edit the values.
# `deployment.env` is git-ignored (matches `*.env`), so machine-specific
# addresses never enter the repository. If `deployment.env` is absent,
# platform.sh / install.sh behave exactly like the single-host `all` role:
# every service starts, everything binds loopback.
#
#   ROLE=all        single host — everything on this machine (today's default)
#   ROLE=web        application tier: Traefik, ForwardAuth, agent platform,
#                   sandbox, harness gateway, user workspaces (compat, PR-H1)
#   ROLE=inference  GPU node: inference engine + node-agent, secretless.
#                   Registers to PLATFORM_URL; needs LAN_BIND_IP, PLATFORM_URL.
#   ROLE=data       state tier: Valkey, VictoriaLogs, SeaweedFS, backups
#                   (compat, PR-H1)
#   ROLE=platform   data+admin tier: Valkey, VictoriaLogs, SeaweedFS, agent
#                   platform, LiteLLM (loopback), fleet control (litellm_sync).
#                   Needs LAN_BIND_IP; GPU nodes register to it.
ROLE=all

# LAN address this machine's outward-facing services bind to. Ignored when
# ROLE=all (loopback is forced). Traefik on web/platform binds every interface
# and is restricted by backend/config/firewall/{web,platform}.nft instead.
LAN_BIND_IP=127.0.0.1

# --- Peer addresses (only the ones this role reaches out to) -----------------
# web       reaches inference (LiteLLM :4000) and data (Valkey/SeaweedFS/VictoriaLogs)
# inference reaches data (Valkey/VictoriaLogs) for its in-process LiteLLM auth
# data      reaches nothing (it only serves)
# platform  reaches nothing directly (GPU nodes register to it; the static
#           PEER_INFERENCE_HOSTS bootstrap list below is replaced by the fleet
#           registry afterwards)
# inference (Phase B) reaches the platform only: fleet API (PLATFORM_URL) for
#           register/heartbeat/desired-state, and the platform's VictoriaLogs
#           for the audit outbox replay.
PEER_INFERENCE_HOST=127.0.0.1
PEER_INFERENCE_PORT=4000
PEER_DATA_HOST=127.0.0.1
PEER_DATA_VALKEY_PORT=6379
PEER_DATA_LOGS_PORT=9428
PEER_DATA_SEAWEEDFS_PORT=8333

# --- Fleet (roles platform / inference, Phase B) -----------------------------
# PLATFORM_URL: base URL of the platform fleet API. Required on inference
# (node-agent registers and heartbeats here); ignored on other roles.
# PLATFORM_URL=https://<platform-lan-ip>:3080
#
# NODE_NAME: fleet identity of this node; the CN of the client certificate
# provisioned by install.sh via backend/services/resilience/fleet-ca.sh.
# Defaults to the machine hostname when unset.
# NODE_NAME=gpu-01
#
# PEER_INFERENCE_HOSTS: comma-separated bootstrap list of GPU node addresses
# (platform role only), e.g. PEER_INFERENCE_HOSTS=10.0.0.21,10.0.0.22
# Used only until the nodes register; the fleet registry is the source of
# truth afterwards. May be empty.
# PEER_INFERENCE_HOSTS=
#
# FLEET_*: consumed by the fleet control loop (scheduler, litellm_sync daemon,
# node-agent). Documented here; the fleet worker owns their semantics.
# FLEET_HEARTBEAT_INTERVAL_S=10
# FLEET_STALE_AFTER_S=30
# FLEET_AUTO_APPROVE=false
