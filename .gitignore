# Local Python environments and test artifacts
backend/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# Downloaded executables and runtime state
backend/bin/
backend/run/
backend/logs/
# Everything under data/ is runtime state except the tracked runbooks, so a new
# runtime file dropped directly in data/ cannot leak into a commit.
backend/data/*
!backend/data/runbooks/

# Generated logs and large test fixtures
backend/tests/fixtures/logs/massive_access_5gb.log

# Provisioned secrets
backend/config/keys/*.key
backend/config/keys/login-credentials.json
backend/config/keys/initial-passwords.txt
*.env
.env*

# Local agent metadata and scratch state
.agents/
.codex/
.harness-scratch/
.live-scratch/

# Test-generated target deployment artifacts
backend/config/test_deploy/
